// Despliegue del frontend en Cloudflare Workers (sitio estático, sin código de servidor)
{
  "name": "g2exchange",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Rutas de React Router como /screener: se sirve index.html
    "not_found_handling": "single-page-application"
  }
}
