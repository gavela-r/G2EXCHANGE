{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "node --watch --require ts-node/register src/index.ts",
    "build": "npm --prefix ../valuation_engine run build && tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --require ./tests/config.cjs --test tests/*.test.cjs",
    "valuation": "node dist/valoracionAutomatica.js",
    "valuation:dev": "ts-node --project tsconfig.json valoracionAutomatica.ts",
    "valuation:watch": "node dist/src/valoracion/watch.js",
    "valuation:replay": "node dist/src/valoracion/replay.js",
    "test:integration": "npm run build && node --test tests/mysqlValoracion.integration.cjs",
    "valuation:classification": "node dist/src/valoracion/informeClasificacion.js",
    "pcv:recover": "node scripts/recuperar-pcv-proveedores.cjs",
    "pcv:reports:jp": "node scripts/recuperar-informes-jp.cjs",
    "pcv:audit": "node scripts/auditar-pcv-kpi-2022-2025.cjs",
    "test:pcv:integration": "npm run build && node --test tests/pcvMysql.integration.cjs tests/informeDiscovery.integration.cjs"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "^9.2.1",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "mysql2": "^3.24.5",
    "pinyin": "^4.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "typescript": "5.6"
  }
}
