{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": { "g2-motor/*": ["../valuation_engine/dist/src/*"] },

    "strict": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": false,

    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "insercionDatos/**/*.ts",
    "conexion/**/*.ts",
    "valoracionAutomatica.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
