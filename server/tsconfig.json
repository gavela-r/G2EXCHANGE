{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "declaration": false,

    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "insercionDatos/**/*.ts",
    "conexion/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}