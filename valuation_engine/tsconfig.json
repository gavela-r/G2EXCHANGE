{
  "compilerOptions": {
    "target": "ES2020", "module": "commonjs", "moduleResolution": "node", "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "types": ["node"], "rootDir": ".", "outDir": "dist"
  },
  "include": ["src/**/*.ts", "generator/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
